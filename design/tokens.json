{
  "$comment": "Single source of design tokens for web (CSS variables) and Android (Compose theme). v2 merges the brand kit (design/brand/brand-guide.md, brand-tokens.json) into the Fluid Glass structure (docs/FLUID_GLASS_UI.md). Token NAMES are unchanged from v1 except the additions marked below; where the brand kit uses a different name the mapping is noted in 'aliases'.",
  "version": 2,
  "aliases": {
    "brand surface (page/card)": "bg / card",
    "brand surface-2 (recessed)": "surface",
    "brand accent-ink (text ON accent fills)": "onAccent (NEW)",
    "brand accentPressed": "accentInk (accent text on soft fills, primary hover/pressed)"
  },
  "color": {
    "light": {
      "bg": "#FFFFFF",
      "card": "#FFFFFF",
      "surface": "#F6F8FC",
      "surface2": "#EDF1F7",
      "line": "#DCE3EE",
      "line2": "#C9D3E1",
      "ink": "#08204F",
      "ink2": "#415373",
      "ink3": "#63718A",
      "accent": "#1059FC",
      "accentInk": "#0A45CC",
      "accentSoft": "#EDF3FF",
      "onAccent": "#FFFFFF",
      "good": "#15803D",
      "bad": "#DC2626",
      "warn": "#B45309",
      "glassBar": "rgba(255,255,255,.88)",
      "glassCard": "rgba(255,255,255,.88)",
      "toast": "rgba(8,32,79,.88)",
      "onToast": "#FFFFFF",
      "scrim": "rgba(8,32,79,.28)",
      "focusRing": "#1059FC",
      "controlBorder": "#63718A",
      "shadowRgb": "8,32,79"
    },
    "dark": {
      "bg": "#0A1122",
      "card": "#0A1122",
      "surface": "#131F35",
      "surface2": "#1A2842",
      "line": "#2A3A55",
      "line2": "#36496A",
      "ink": "#F5F8FF",
      "ink2": "#C2CEE2",
      "ink3": "#91A2BF",
      "accent": "#4A82FF",
      "accentInk": "#7BA3FF",
      "accentSoft": "#172B52",
      "onAccent": "#0A1122",
      "good": "#4ADE80",
      "bad": "#FF8585",
      "warn": "#F2A93B",
      "glassBar": "rgba(10,17,34,.88)",
      "glassCard": "rgba(19,31,53,.88)",
      "toast": "rgba(245,248,255,.94)",
      "onToast": "#0A1122",
      "scrim": "rgba(0,0,0,.5)",
      "focusRing": "#4A82FF",
      "controlBorder": "#91A2BF",
      "shadowRgb": "0,0,0"
    },
    "tint": { "up": "21,128,61", "down": "220,38,38", "accent": "16,89,252" },
    "categoryPalette": [
      { "id": "housing",       "hex": "#2978C9", "symbol": "circle" },
      { "id": "food",          "hex": "#C96523", "symbol": "square" },
      { "id": "transport",     "hex": "#178879", "symbol": "triangle" },
      { "id": "fun",           "hex": "#A65DA8", "symbol": "diamond" },
      { "id": "subscriptions", "hex": "#A87914", "symbol": "plus" },
      { "id": "health",        "hex": "#C65172", "symbol": "cross" },
      { "id": "roth",          "hex": "#6B75C6", "symbol": "ring" },
      { "id": "401k",          "hex": "#648631", "symbol": "square-ring" },
      { "id": "brokerage",     "hex": "#B46B51", "symbol": "triangle-ring" },
      { "id": "hsa",           "hex": "#778190", "symbol": "diamond-ring" }
    ],
    "$categoryAssignment": "Default palette id per category name (case-insensitive) when categories.color is null. Distinct within each group (income / expenses / savings). User-added categories: first palette id not used in their group, cycling. categories.color may hold a palette id to override.",
    "categoryAssignment": {
      "Paychecks": "401k",
      "Rent": "housing",
      "Subscriptions": "subscriptions",
      "Food": "food",
      "Fun": "fun",
      "Gas": "transport",
      "Misc": "hsa",
      "Car Ins": "health",
      "Utilities": "roth",
      "Phone Bill": "brokerage",
      "Roth": "roth",
      "401k": "401k",
      "Taxable Brokerage": "brokerage",
      "HSA": "hsa"
    }
  },
  "radius": { "card": 12, "control": 8, "pick": 10, "seg": 10, "menu": 14, "sheet": 24, "floatingBar": 24, "pill": 999 },
  "spacing": [4, 6, 8, 10, 14, 18, 28],
  "type": {
    "$comment": "px on web, sp on Android. letterSpacing in px at that size (Compose: (px/size).em). Fonts are BUNDLED in both apps (no network font loading).",
    "display":   { "family": "Barlow Condensed", "weight": 600, "size": 40, "lineHeight": 44, "letterSpacing": 0.8,   "case": "uppercase" },
    "title":     { "family": "Inter", "weight": 600, "size": 24, "lineHeight": 30, "letterSpacing": -0.48 },
    "cardTitle": { "family": "Inter", "weight": 600, "size": 16, "lineHeight": 24, "letterSpacing": 0 },
    "body":      { "family": "Inter", "weight": 400, "size": 16, "lineHeight": 24, "letterSpacing": 0 },
    "control":   { "family": "Inter", "weight": 500, "size": 16, "lineHeight": 24, "letterSpacing": 0 },
    "secondary": { "family": "Inter", "weight": 400, "size": 14, "lineHeight": 20, "letterSpacing": 0 },
    "numbers":   { "family": "Inter", "weight": 600, "size": 32, "lineHeight": 40, "letterSpacing": -0.32, "fontFeatureSettings": "\"tnum\" 1, \"lnum\" 1" },
    "tableNumber": { "family": "Inter", "weight": 500, "size": 16, "lineHeight": 24, "letterSpacing": 0, "fontFeatureSettings": "\"tnum\" 1, \"lnum\" 1" },
    "micro":     { "family": "Inter", "weight": 600, "size": 12, "lineHeight": 16, "letterSpacing": 0.72, "case": "uppercase" },
    "wordmark":  { "family": "Inter", "weight": 600, "size": 28, "letterSpacing": -0.56 }
  },
  "motion": {
    "ease": [0.22, 1, 0.36, 1],
    "spring": [0.34, 1.4, 0.64, 1],
    "pressScale": 0.97,
    "press": 160,
    "hover": 220,
    "glide": 450,
    "appear": 450,
    "arrive": 500,
    "reorder": 650,
    "tint": 1400,
    "exitFactor": 0.6
  },
  "hitTarget": { "android": 48, "web": 44 }
}
